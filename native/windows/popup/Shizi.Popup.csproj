<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Shizi.Popup</RootNamespace>
    <AssemblyName>Shizi.Popup</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- SelfContained 时不走系统 bootstrap 初始化（避免缺 Main 包 / 版本错配） -->
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!--
    .NET + WASDK 一律自包含 + WindowsAppSdkBootstrapInitialize=false。
    原因：
    1) Framework-dependent 在无 Desktop Runtime 机器上会弹「需要 .NET 8.0」；
    2) 本机常有 WindowsAppRuntime.1.5 但缺 Main.1.5，FD 会弹 WASDK 版本提示。
    子进程随 shizi 分发，不应依赖用户系统是否装过 .NET / WASDK Main。
    Debug 体积/编译稍大，但与 Release 行为一致，避免 dev 路径踩坑。
  -->
  <PropertyGroup>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- pin 1.5；与计划一致。若需 1.6+ 仅改 Version -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240802000" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.3233" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- 测试工程在子目录；SDK 默认 **/*.cs 会误编，需显式排除 -->
  <ItemGroup>
    <Compile Remove="Shizi.Popup.Tests/**" />
    <None Remove="Shizi.Popup.Tests/**" />
    <EmbeddedResource Remove="Shizi.Popup.Tests/**" />
    <Page Remove="Shizi.Popup.Tests/**" />
  </ItemGroup>

  <!-- 与设置页对齐的服务品牌图标（SVG） -->
  <ItemGroup>
    <Content Include="Assets\service-icons\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>

