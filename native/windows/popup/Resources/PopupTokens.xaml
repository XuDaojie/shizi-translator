<?xml version="1.0" encoding="UTF-8"?>
<!--
  浅色 token + 控件皮：对齐 Open Design winui3.css / components.css（#popup-winui3）
  关键：用自定义 ControlTemplate 去掉 WinUI 默认 TextBox/Button chrome，否则「像素级」做不到。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:media="using:Microsoft.UI.Xaml.Media">

    <!-- ===== 色 ===== -->
    <SolidColorBrush x:Key="PopupFgBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="PopupFg2Brush" Color="#5D5D5D" />
    <SolidColorBrush x:Key="PopupFg3Brush" Color="#8A8A8A" />
    <SolidColorBrush x:Key="PopupAccentBrush" Color="#D55A1F" />
    <SolidColorBrush x:Key="PopupAccentHoverBrush" Color="#C25016" />
    <SolidColorBrush x:Key="PopupAccentSoftBrush" Color="#1AD55A1F" />
    <SolidColorBrush x:Key="PopupOnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PopupSuccessBrush" Color="#107C10" />
    <SolidColorBrush x:Key="PopupDestructiveBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="PopupWarningBrush" Color="#CA5010" />

    <!-- 卡表面：winui3.css rgba(255,255,255,0.72)=#B8FFFFFF；soft 0.55=#8CFFFFFF -->
    <SolidColorBrush x:Key="PopupCardBgBrush" Color="#B8FFFFFF" />
    <SolidColorBrush x:Key="PopupSoftBrush" Color="#8CFFFFFF" />
    <!-- 原型 border 0.5px @ 6%；WinUI 用 1px 等价 -->
    <SolidColorBrush x:Key="PopupBorderBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="PopupBorder2Brush" Color="#1F000000" />
    <SolidColorBrush x:Key="PopupHoverBrush" Color="#0A000000" />
    <SolidColorBrush x:Key="PopupPressedBrush" Color="#06000000" />
    <!-- 引擎图标默认底 -->
    <SolidColorBrush x:Key="PopupEngineIconBgBrush" Color="#D55A1F" />
    <!-- 无 Mica 时窗底：#F4F4F4 @ 80%（对齐设计 / 用户 Mica 透明度 80%） -->
    <SolidColorBrush x:Key="PopupMicaFallbackBrush" Color="#CCF4F4F4" />
    <SolidColorBrush x:Key="PopupShellEdgeBrush" Color="#0F000000" />

    <x:Double x:Key="PopupWindowWidth">468</x:Double>
    <x:Double x:Key="PopupTitleBarHeight">44</x:Double>
    <x:Double x:Key="PopupIconBtnSize">36</x:Double>
    <x:Double x:Key="PopupMetaBtnSize">24</x:Double>
    <x:Double x:Key="PopupLangSwapWidth">38</x:Double>

    <!--
      字阶对齐 Open Design winui3 + components.css（1rem≈16px）：
      body 0.8125rem=13 · engine 0.6875rem=11 Medium · caption/badge 11 · meta/token 10
    -->
    <FontFamily x:Key="PopupFontFamily">Segoe UI Variable, Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
    <FontFamily x:Key="PopupMonoFontFamily">Cascadia Mono, Consolas, Courier New</FontFamily>
    <x:Double x:Key="PopupFontSizeBody">13</x:Double>
    <x:Double x:Key="PopupFontSizeCaption">12</x:Double>
    <x:Double x:Key="PopupFontSizeBadge">11</x:Double>
    <x:Double x:Key="PopupFontSizeEngine">11</x:Double>
    <x:Double x:Key="PopupFontSizeMeta">10</x:Double>
    <x:Double x:Key="PopupLineHeightBody">20.8</x:Double>
    <!-- 正文 line-height 1.55（源文）/ 1.6（结果）共用 20.8≈13×1.6 -->
    <x:Double x:Key="PopupLineHeightSource">20.15</x:Double>
    <!-- ThemeShadow Z：约等于 CSS 0 1.6px 3.2px / hover 0 2px 8px -->
    <x:Double x:Key="PopupCardElevation">12</x:Double>
    <x:Double x:Key="PopupCardElevationHover">28</x:Double>

    <CornerRadius x:Key="PopupCornerSm">4</CornerRadius>
    <CornerRadius x:Key="PopupCornerMd">8</CornerRadius>
    <CornerRadius x:Key="PopupCornerBrand">5</CornerRadius>
    <CornerRadius x:Key="PopupCornerPill">10</CornerRadius>
    <CornerRadius x:Key="PopupCornerShell">8</CornerRadius>

    <!-- ===== 无 chrome 图标按钮（36 / 24 / 窗控）===== -->
    <Style x:Key="PopupIconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="{StaticResource PopupIconBtnSize}" />
        <Setter Property="Height" Value="{StaticResource PopupIconBtnSize}" />
        <Setter Property="CornerRadius" Value="{StaticResource PopupCornerSm}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}"
                          CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter x:Name="Content"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource PopupHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource PopupPressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PopupMetaButtonStyle" TargetType="Button" BasedOn="{StaticResource PopupIconButtonStyle}">
        <Setter Property="Width" Value="{StaticResource PopupMetaBtnSize}" />
        <Setter Property="Height" Value="{StaticResource PopupMetaBtnSize}" />
    </Style>

    <Style x:Key="PopupWinButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="{StaticResource PopupTitleBarHeight}" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}">
                        <ContentPresenter x:Name="Content"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource PopupHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource PopupPressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 语言侧按钮：满宽、居中 label + chevron -->
    <Style x:Key="PopupLangSideButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource PopupFgBrush}" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource PopupHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource PopupPressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 无边框多行 TextBox（剥掉默认 underline / 外框）===== -->
    <Style x:Key="PopupSourceTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource PopupFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource PopupFontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource PopupFgBrush}" />
        <Setter Property="SelectionHighlightColor" Value="{StaticResource PopupAccentSoftBrush}" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollMode" Value="Auto" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <ScrollViewer x:Name="ContentElement"
                                      Margin="0"
                                      Padding="0"
                                      HorizontalScrollMode="{TemplateBinding ScrollViewer.HorizontalScrollMode}"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollMode="{TemplateBinding ScrollViewer.VerticalScrollMode}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                      IsTabStop="False"
                                      ZoomMode="Disabled"
                                      AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock x:Name="PlaceholderTextContentPresenter"
                                   Margin="0"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   Foreground="{StaticResource PopupFg3Brush}"
                                   Text="{TemplateBinding PlaceholderText}"
                                   IsHitTestVisible="False"
                                   TextWrapping="Wrap" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Focused" />
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ButtonStates">
                                <VisualState x:Name="ButtonVisible" />
                                <VisualState x:Name="ButtonCollapsed" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
