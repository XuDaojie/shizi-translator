<?xml version="1.0" encoding="UTF-8"?>
<Window
    x:Class="Shizi.Popup.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Shizi 翻译">

    <Grid x:Name="RootGrid"
          Background="{ThemeResource LayerFillColorDefaultBrush}"
          Width="420"
          MinHeight="120">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶栏：可拖；无系统标题栏时作拖动手柄 -->
        <Border x:Name="AppTitleBar"
                Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,0">
            <Grid>
                <TextBlock Text="Shizi"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Opacity="0.9" />
                <TextBlock x:Name="TitleHint"
                           Text="原生弹窗"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           FontSize="12"
                           Opacity="0.55" />
            </Grid>
        </Border>

        <!-- 内容占位（任务 9–10 替换为完整 UI） -->
        <Border Grid.Row="1" Padding="16">
            <StackPanel Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="PlaceholderText"
                           Text="Shizi Popup"
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="WinUI 壳已就绪 · Bridge 待完整 UI"
                           FontSize="12"
                           Opacity="0.6"
                           HorizontalAlignment="Center"
                           TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
