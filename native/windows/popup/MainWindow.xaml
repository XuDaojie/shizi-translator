<?xml version="1.0" encoding="UTF-8"?>
<Window
    x:Class="Shizi.Popup.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Shizi 翻译">

    <Grid x:Name="RootGrid"
          Background="{ThemeResource LayerFillColorDefaultBrush}"
          Width="420"
          MinHeight="120"
          SizeChanged="RootGrid_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏：可拖；图钉 / 截图译 / 收藏 / 设置 -->
        <Border x:Name="AppTitleBar"
                Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button x:Name="PinButton"
                            Width="32" Height="32"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="PinButton_Click"
                            ToolTipService.ToolTip="置顶">
                        <FontIcon Glyph="&#xE840;" FontSize="14" />
                    </Button>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="Shizi"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Opacity="0.85"
                           IsHitTestVisible="False" />

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="2"
                            VerticalAlignment="Center">
                    <Button x:Name="OcrButton"
                            Width="32" Height="32"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OcrButton_Click"
                            ToolTipService.ToolTip="截图翻译">
                        <FontIcon Glyph="&#xE8B8;" FontSize="14" />
                    </Button>
                    <Button x:Name="BookmarkButton"
                            Width="32" Height="32"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="BookmarkButton_Click"
                            ToolTipService.ToolTip="收藏">
                        <FontIcon Glyph="&#xE734;" FontSize="14" />
                    </Button>
                    <Button x:Name="SettingsButton"
                            Width="32" Height="32"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="SettingsButton_Click"
                            ToolTipService.ToolTip="设置">
                        <FontIcon Glyph="&#xE713;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 内容：原文 / 语言 / 结果卡 -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="12,10,12,6">
            <StackPanel x:Name="ContentPanel" Spacing="10">

                <!-- 原文卡 -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock x:Name="SourceLangBadge"
                                           Text="自动检测"
                                           FontSize="11"
                                           Opacity="0.7"
                                           VerticalAlignment="Center" />
                                <Border x:Name="SourceTypeBadgeBorder"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="4"
                                        Padding="6,1"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="SourceTypeBadge"
                                               Text=""
                                               FontSize="10"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Spacing="0">
                                <Button Width="28" Height="28" Padding="0"
                                        Background="Transparent" BorderThickness="0"
                                        Click="SourceCopy_Click"
                                        ToolTipService.ToolTip="复制">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                </Button>
                                <Button Width="28" Height="28" Padding="0"
                                        Background="Transparent" BorderThickness="0"
                                        Click="SourceSpeak_Click"
                                        ToolTipService.ToolTip="朗读">
                                    <FontIcon Glyph="&#xE767;" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <TextBox x:Name="SourceTextBox"
                                 Grid.Row="1"
                                 Margin="0,6,0,0"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 PlaceholderText="输入或粘贴要翻译的文本…"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 MinHeight="48"
                                 MaxHeight="160"
                                 FontSize="14"
                                 TextChanged="SourceTextBox_TextChanged"
                                 KeyDown="SourceTextBox_KeyDown" />

                        <Button x:Name="TranslateButton"
                                Grid.Row="2"
                                Content="翻译"
                                HorizontalAlignment="Right"
                                Margin="0,4,0,0"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="TranslateButton_Click" />
                    </Grid>
                </Border>

                <!-- 语言栏 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="SourceLangCombo"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="SourceLangCombo_SelectionChanged" />

                    <Button Grid.Column="1"
                            Width="36" Height="32"
                            Margin="4,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="SwapLang_Click"
                            ToolTipService.ToolTip="交换语言">
                        <FontIcon Glyph="&#xE8AB;" FontSize="14" />
                    </Button>

                    <ComboBox x:Name="TargetLangCombo"
                              Grid.Column="2"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="TargetLangCombo_SelectionChanged" />
                </Grid>

                <!-- 结果卡列表 -->
                <StackPanel x:Name="ResultsPanel" Spacing="8" />
            </StackPanel>
        </ScrollViewer>

        <!-- 状态栏 + tip -->
        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <StackPanel Spacing="4">
                <InfoBar x:Name="TipBar"
                         IsOpen="False"
                         IsClosable="True"
                         Severity="Informational"
                         CloseButtonClick="TipBar_CloseButtonClick" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ProgressRing x:Name="StatusRing"
                                      Width="14" Height="14"
                                      IsActive="False" />
                        <TextBlock x:Name="StatusText"
                                   Text="就绪"
                                   FontSize="12"
                                   Opacity="0.8"
                                   VerticalAlignment="Center" />
                        <HyperlinkButton x:Name="StatusActionButton"
                                         Content="取消"
                                         FontSize="12"
                                         Padding="4,0"
                                         Visibility="Collapsed"
                                         Click="StatusAction_Click" />
                    </StackPanel>

                    <TextBlock x:Name="CharCountText"
                               Grid.Column="1"
                               Text="0 字"
                               FontSize="12"
                               Opacity="0.55"
                               VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
