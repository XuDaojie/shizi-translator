  "scripts": {
    "tauri": "tauri",
    "dev": "vite --config frontend/vite.config.ts",
    "build": "vite build --config frontend/vite.config.ts",
    "typecheck": "vue-tsc --noEmit -p frontend/tsconfig.json",
    "test": "vitest run --config frontend/vite.config.ts",
    "test:watch": "vitest --config frontend/vite.config.ts",
    "tauri:build": "tauri build --bundles nsis",
    "tauri:build:full": "tauri build --bundles nsis --config src-tauri/tauri.conf.full.json",
    "tauri:build:dual": "node scripts/build-nsis-dual.js",
    "release:bump": "node scripts/bump-version.js",
    "release:bump:dry": "node scripts/bump-version.js --dry",
    "release:bump:beta": "node scripts/bump-version.js --beta",
    "release:bump:dry:beta": "node scripts/bump-version.js --dry --beta"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22",
    "@vitejs/plugin-vue": "^6.0.8",
    "tailwindcss": "^4",
    "typescript": "^5.6",
    "vite": "^8",
    "vitest": "^3",
    "vue-tsc": "^3"
  },
  "dependencies": {
    "@iconify/vue": "^5",
    "@lucide/vue": "^1.24.0",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.12",
    "isomorphic-dompurify": "^3.19.0",
    "marked": "^18.0.7",
    "reka-ui": "^2.10.1",
    "shadcn-vue": "^2.7.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5"
  }
